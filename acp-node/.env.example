# Shared secret — Python backend sends this in X-Service-Auth header
ACP_NODE_SHARED_SECRET=change-me-to-a-long-random-string

# Privy (source: @virtuals-protocol/acp-node-v2/src/core/constants.ts)
PRIVY_APP_ID=cltsev9j90f67yhyw4sngtrpv
PRIVY_APP_SECRET=

# Hyperliquid (hardcoded but overridable for testnet)
HL_API_URL=https://api.hyperliquid.xyz/exchange
HL_CHAIN_ID=42161

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
