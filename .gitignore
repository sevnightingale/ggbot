# .gitignore for ggbot

# Python cache
__pycache__/
*.py[cod]

# Virtual environments
.venv/
env/
venv/

# Local environment files
.env
.env.*

# Logs
logs/
*.log

# OS system files
.DS_Store
Thumbs.db


# Telegram session files
*.session
*.session-journal

# ggShot service directory (contains sensitive configs and session data)
ggshot/
