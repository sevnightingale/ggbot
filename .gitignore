# .gitignore for ggbot

# Python cache
__pycache__/
*.py[cod]

# Virtual environments
.venv/
.venv-agent/
env/
venv/

# Local environment files
.env
.env.*
docker-compose.override.yml

# Logs
logs/
*.log

# OS system files
.DS_Store
Thumbs.db

# Credentials and sensitive data
**/*credentials*
**/*.key
**/*.pem
**/*.secret
**/certs/

# Browser session cookies
**/cookies.json
**/temp_cookies.json

# Temporary paper trading data
**/paper_trade_data/

# Activity export files (contain user trading data)
*_activities_*.json

# Node.js (root-level only; frontend/ manages its own)
node_modules/
package-lock.json
package.json

# OpenAPI generation config
openapitools.json

# MCP configuration (contains database credentials)
.mcp.json

# Development files
installed_packages.txt
.vercel

# Local-only dev working notes (kept on disk, not published)
/CLAUDE.local.md
/ACTIVE.md
DOCS/completed/2026-06-04_*.md
sessions/
